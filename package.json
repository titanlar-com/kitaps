{
  "name": "kitaps",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "seo": "node scripts/generate-sitemap.mjs",
    "build": "npm run seo && vite build && node scripts/generate-static-seo.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "data": "python3 scripts/merge-data.py",
    "test": "npm run test:node && npm run test:components",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "export": "vite build --mode standalone && node scripts/export-standalone.mjs",
    "test:node": "node --test tests/*.test.js",
    "test:components": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@tabler/icons-react": "^3.35.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^5.0.2"
  }
}
